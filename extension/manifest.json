{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/langfeld/zen-tab-sleep",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "alarms",
    "menus",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "popup.html?options"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{1ddaa81f-d9db-4f5b-9a9f-128fe813b686}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
